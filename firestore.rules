rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function profile() { return get(/databases/$(database)/documents/user/$(request.auth.uid)).data; }
    function active() { return signedIn() && profile().status == 'active'; }
    function admin() { return active() && profile().role == 'admin'; }
    function permitted(key, action) { return active() && (admin() || profile().permissions[key][action] == true); }
    function validSignup(uid) {
      return signedIn()
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['email', 'role', 'status', 'permissions', 'createdAt', 'updatedAt'])
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.role == 'user'
        && request.resource.data.status == 'pending'
        && request.resource.data.createdAt is timestamp
        && request.resource.data.updatedAt is timestamp
        && request.resource.data.permissions.keys().hasOnly([
          'dashboard', 'customers', 'enquiries', 'executives', 'products',
          'salesVouchers', 'voucherSettings', 'areas', 'reports'
        ])
        && request.resource.data.permissions.dashboard == { view: false, add: false, edit: false, delete: false }
        && request.resource.data.permissions.customers == { view: false, add: false, edit: false, delete: false }
        && request.resource.data.permissions.enquiries == { view: false, add: false, edit: false, delete: false }
        && request.resource.data.permissions.executives == { view: false, add: false, edit: false, delete: false }
        && request.resource.data.permissions.products == { view: false, add: false, edit: false, delete: false }
        && request.resource.data.permissions.salesVouchers == { view: false, add: false, edit: false, delete: false }
        && request.resource.data.permissions.voucherSettings == { view: false, add: false, edit: false, delete: false }
        && request.resource.data.permissions.areas == { view: false, add: false, edit: false, delete: false }
        && request.resource.data.permissions.reports == { view: false };
    }

    match /user/{uid} {
      allow create: if validSignup(uid);
      allow get: if signedIn() && request.auth.uid == uid;
      allow get, list, update, delete: if admin();
    }

    match /customers/{document=**} {
      allow read: if permitted('customers', 'view') || permitted('dashboard', 'view') || permitted('salesVouchers', 'view') || permitted('voucherSettings', 'view') || permitted('enquiries', 'view') || permitted('reports', 'view');
      allow create: if permitted('customers', 'add');
      allow update: if permitted('customers', 'edit');
      allow delete: if permitted('customers', 'delete');
    }
    match /enquiries/{document=**} { allow read: if permitted('enquiries', 'view') || permitted('reports', 'view'); allow create: if permitted('enquiries', 'add'); allow update: if permitted('enquiries', 'edit'); allow delete: if permitted('enquiries', 'delete'); }
    match /executives/{document=**} {
      allow read: if permitted('executives', 'view') || permitted('dashboard', 'view') || permitted('salesVouchers', 'view') || permitted('voucherSettings', 'view') || permitted('enquiries', 'view') || permitted('reports', 'view');
      allow create: if permitted('executives', 'add'); allow update: if permitted('executives', 'edit'); allow delete: if permitted('executives', 'delete');
    }
    match /products/{document=**} {
      allow read: if permitted('products', 'view') || permitted('dashboard', 'view') || permitted('salesVouchers', 'view') || permitted('enquiries', 'view') || permitted('reports', 'view');
      allow create: if permitted('products', 'add'); allow update: if permitted('products', 'edit'); allow delete: if permitted('products', 'delete');
    }
    match /areas/{document=**} {
      allow read: if permitted('areas', 'view') || permitted('salesVouchers', 'view') || permitted('enquiries', 'view') || permitted('reports', 'view');
      allow create: if permitted('areas', 'add'); allow update: if permitted('areas', 'edit'); allow delete: if permitted('areas', 'delete');
    }
    match /salesVouchers/{document=**} {
      allow read: if permitted('salesVouchers', 'view') || permitted('dashboard', 'view') || permitted('customers', 'view') || permitted('voucherSettings', 'view') || permitted('reports', 'view');
      allow create: if permitted('salesVouchers', 'add'); allow update: if permitted('salesVouchers', 'edit'); allow delete: if permitted('salesVouchers', 'delete');
    }
    match /freeSupportVouchers/{document=**} {
      allow read: if permitted('salesVouchers', 'view') || permitted('dashboard', 'view') || permitted('customers', 'view') || permitted('reports', 'view');
      allow create: if permitted('salesVouchers', 'add'); allow update: if permitted('salesVouchers', 'edit'); allow delete: if permitted('salesVouchers', 'delete');
    }
    match /callReceiptVouchers/{document=**} {
      allow read: if permitted('voucherSettings', 'view') || permitted('dashboard', 'view') || permitted('customers', 'view') || permitted('executives', 'view') || permitted('reports', 'view');
      allow create: if permitted('voucherSettings', 'add'); allow update: if permitted('voucherSettings', 'edit'); allow delete: if permitted('voucherSettings', 'delete');
    }
    match /voucherSettings/{document=**} { allow read: if permitted('salesVouchers', 'view') || permitted('voucherSettings', 'view') || permitted('reports', 'view'); allow create, update: if permitted('salesVouchers', 'add') || permitted('salesVouchers', 'edit') || permitted('voucherSettings', 'add') || permitted('voucherSettings', 'edit'); }
    match /salesVoucherNumberClaims/{document=**} { allow read, create: if permitted('salesVouchers', 'add'); }
    match /freeSupportVoucherNumberClaims/{document=**} { allow read, create: if permitted('salesVouchers', 'add'); }
    match /callReceiptVoucherNumberClaims/{document=**} { allow read, create: if permitted('voucherSettings', 'add'); }
    match /{document=**} { allow read, write: if admin(); }
  }
}
